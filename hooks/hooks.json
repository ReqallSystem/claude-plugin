{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/src/hooks/session-start.js\"",
            "timeout": 15,
            "statusMessage": "Loading Reqall project context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/src/hooks/user-prompt-submit.js\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/src/hooks/pre-tool.js\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/src/hooks/post-tool.js\"",
            "timeout": 15,
            "async": true
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/src/hooks/plan-accepted.js\"",
            "timeout": 15,
            "statusMessage": "Recording accepted plan as Reqall intent"
          }
        ]
      },
      {
        "matcher": "mcp__plugin_reqall_reqall__upsert_record|mcp__Reqall__upsert_record|mcp__plugin_reqall_reqall__get_record|mcp__Reqall__get_record",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/src/hooks/intent-track.js\"",
            "timeout": 15,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/src/hooks/stop.js\"",
            "timeout": 15,
            "statusMessage": "Checking Reqall persistence"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/src/hooks/subagent-stop.js\"",
            "timeout": 15,
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/src/hooks/pre-compact.js\"",
            "timeout": 15,
            "statusMessage": "Persisting to Reqall before compaction"
          }
        ]
      }
    ]
  }
}
